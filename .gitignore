# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups de dados de produção (rollback/dumps) — nunca versionar
scripts/_backups/

# marketing/videos: projeto Remotion. Código versionado; dependências e
# vídeos renderizados (MP4) ficam só no disco, nunca no git/deploy.
/marketing/videos/node_modules/
/marketing/videos/out/
